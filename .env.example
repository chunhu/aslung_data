# Public HTTPS origin, exactly matching browser URL; no trailing slash.
APP_ORIGIN=https://aslung.example.com
# Membership / permissions SQLite database. Measurement data stays in your existing database.
DATABASE_PATH=/app/data/aslung.sqlite
BACKUP_PATH=/app/backups
# Existing ASLUNG MySQL source. Use a read-only account; required for measurements.
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
NEXT_TELEMETRY_DISABLED=1
# Build-stage Node.js heap limit (MiB), shared by app and worker builds.
# A small EC2 still needs sufficient RAM/swap; runtime limits are unchanged.
NODE_BUILD_HEAP_MB=1024
# Calibration result storage: local (default) or s3. Uses the EC2 IAM Role.
CALIBRATION_STORAGE=local
AWS_REGION=ap-northeast-1
S3_BUCKET=aslung-calibration-prod-20261020
# Stage 1 retains local files; no automatic deletion or historical migration.

# LI-COR HOBO API token. Server-only; never use a NEXT_PUBLIC_ variable.
LICOR_API_TOKEN=
# HOBO observations: local or s3. Uses S3_BUCKET / AWS_REGION and EC2 IAM Role.
HOBO_STORAGE=local
# Shared minimum LI-COR API request interval (milliseconds), including split/retry requests.
HOBO_API_INTERVAL_MS=15000
# Per-logger pause between completed calendar-month windows (milliseconds).
HOBO_MONTH_PAUSE_MS=60000
