# Public HTTPS origin, exactly matching browser URL; no trailing slash.
APP_ORIGIN=https://aslung.example.com
# Membership / permissions SQLite database. Measurement data stays in your existing database.
DATABASE_PATH=/app/data/aslung.sqlite
BACKUP_PATH=/app/backups
# Your existing measurement API (HTTPS + Bearer token), optional until configured.
EC2_DATA_API_URL=
EC2_DATA_API_TOKEN=
NEXT_TELEMETRY_DISABLED=1
