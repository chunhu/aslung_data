{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RawArchiveObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::aslung-calibration-prod-20261020/raw/*"
    },
    {
      "Sid": "RawArchiveVersions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::aslung-calibration-prod-20261020",
      "Condition": {
        "StringLike": {
          "s3:prefix": "raw/*"
        }
      }
    },
    {
      "Sid": "ReadArchiveVersioning",
      "Effect": "Allow",
      "Action": "s3:GetBucketVersioning",
      "Resource": "arn:aws:s3:::aslung-calibration-prod-20261020"
    }
  ]
}
